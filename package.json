{
	"name": "@kitschpatrol/prettier-plugin-astro",
	"version": "0.14.1-fork.6",
	"description": "A fork of Prettier Plugin Astro with minor fixes.",
	"keywords": [
		"prettier-plugin",
		"prettier",
		"astro",
		"formatter"
	],
	"homepage": "https://github.com/kitschpatrol/prettier-plugin-astro",
	"bugs": "https://github.com/kitschpatrol/prettier-plugin-astro/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/prettier-plugin-astro.git"
	},
	"license": "MIT",
	"contributors": [
		{
			"name": "Eric Mika",
			"email": "eric@ericmika.com",
			"url": "https://ericmika.com"
		}
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist/*"
	],
	"scripts": {
		"bench": "vitest bench --run --compare test/benchmarks/baseline.json",
		"bench:baseline": "vitest bench --run --outputJson test/benchmarks/baseline.json",
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --preid fork --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp) --tag latest",
		"test": "vitest run"
	},
	"dependencies": {
		"@astrojs/compiler": "^4.0.0",
		"sass-formatter": "^0.8.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.9.0",
		"@types/node": "~24.13.4",
		"bumpp": "^12.3.0",
		"prettier": "^3.9.8",
		"publint": "^0.3.24",
		"shx": "^0.4.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"peerDependencies": {
		"prettier": "^3.7.0"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=18.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.16.0"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
